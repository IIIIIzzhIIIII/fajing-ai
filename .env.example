# 复制为 .env（或直接配到服务器环境变量），不要提交真实值
# 生产必须显式指定 prod：否则会落到 local 默认配置（mock 支付/演示登录风险）
SPRING_PROFILES_ACTIVE=prod
WECHAT_APPID=
WECHAT_SECRET=
# 公众号（服务号）网页授权，用于 H5 公众号支付拿 openid；与小程序 AppID 不同
WECHAT_OAUTH_APPID=
WECHAT_OAUTH_SECRET=
# 微信支付公钥模式（新商户）：回调头 wechatpay-serial 为 PUB_KEY_ID_xxx
WECHAT_PAY_PUBLIC_KEY_PATH=
WECHAT_PAY_PUBLIC_KEY_ID=
TOKEN_SECRET=至少32位的随机字符串
DB_URL=jdbc:mysql://127.0.0.1:3306/fajing?useUnicode=true&characterEncoding=utf8&serverTimezone=Asia/Shanghai&useSSL=false&allowPublicKeyRetrieval=true
DB_USER=root
DB_PASSWORD=
UPLOAD_DIR=/opt/fajing/uploads
# 支付商户私钥目录：必须在上传目录之外，避免私钥通过 /uploads/** 被公开下载；留空默认 /opt/fajing/fajing-cert
CERT_DIR=/opt/fajing/fajing-cert
BASE_URL=https://api.example.com
# 用户端 H5 站点地址：支付宝支付完成后的回跳域名（与 API 域名分离时必填），留空则回退 BASE_URL
H5_BASE_URL=https://example.com
# 允许跨域的前端来源：用户端 H5 + 管理端（逗号分隔，不要带路径）
CORS_ALLOWED_ORIGINS=https://example.com,https://admin.example.com
# 管理端只允许白名单来源访问时，仍需密码登录；初始化后请移除 ADMIN_INIT_PASSWORD
STORAGE_TYPE=local
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_REGION=auto
S3_PUBLIC_BASE_URL=
ADMIN_INIT_PASSWORD=
# 支付参数（渠道密钥/私钥）加密密钥：至少 32 位随机串，缺失时管理端无法保存支付参数
PAY_CONFIG_SECRET=
# 生产必须保持 false：模拟支付会跳过真实收款直接解锁，演示登录可免微信建档
PAY_MOCK_ENABLED=false
AUTH_MOCK_ENABLED=false
# H5 游客登录：浏览器本地生成匿名账号，保证 H5 端有可用登录入口；每 IP 每日最多建档 20 个
AUTH_GUEST_ENABLED=true
SILICONFLOW_KEY=
DEEPSEEK_KEY=
